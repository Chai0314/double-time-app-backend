# 运行环境
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============= 数据库 =============
# 选填：mysql 或 sqlite（默认 sqlite，开发期零配置）
DB_DRIVER=sqlite

# 当 DB_DRIVER=mysql 时生效
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=couple_space
DB_USER=couple
DB_PASSWORD=couple_pwd

# 当 DB_DRIVER=sqlite 时生效
DB_STORAGE=./data/couple_space.sqlite

# JWT（生产请改强随机串）
JWT_SECRET=couple_space_jwt_secret_change_me
JWT_EXPIRES_IN=30d

# 文件上传
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# CORS（开发期 * 即可；上线请收紧）
CORS_ORIGIN=*
